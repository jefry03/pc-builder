<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Create Your PC</title>
</head>
<body>
    <%- include('./partials/navbar') %>
    <h1>Create your dream PC</h1>
    <form action="/pc-builds" method="POST">

        <div>
            <label for="name">PC BUILD NAME:</label><br>
            <input type="text" id="name" name="name" required><br><br>
        </div>
        <div class="pc-builds">
            <label for="components">Processor (CPU):</label>
            <select required name="components" id="cpu" required>
                <% cpuComponents.forEach(component => { %>
                    <option value="">--------</option>
                    <option value="<%= component._id %>"><%= component.componnentname %></option>
                <% }) %>
            </select>
        </div>

        <div class="pc-builds">
            <label for="components">Graphics Processing Unit (GPU):</label>
            <select required name="components" id="gpu" required>
                <% gpuComponents.forEach(component => { %>
                    <option value="">--------</option>
                    <option value="<%= component._id %>"><%= component.componnentname %></option>
                <% }) %>
            </select>
        </div>

        <div class="pc-builds">
            <label for="components">Random Access Memory (RAM):</label>
            <select required name="components" id="ram" required>
                <% ramComponents.forEach(component => { %>
                    <option value="">--------</option>
                    <option value="<%= component._id %>"><%= component.componnentname %></option>
                <% }) %>
            </select>
        </div>

        <div class="pc-builds">
            <label for="components">MOTHERBOARD:</label>
            <select required name="components" id="motherboard" required>
                <% motherboardComponents.forEach(component => { %>
                    <option value="">--------</option>
                    <option value="<%= component._id %>"><%= component.componnentname %></option>
                <% }) %>
            </select>
        </div>

        <div class="pc-builds">
            <label for="components">CASE:</label>
            <select required name="components" id="case" required>
                <% caseComponents.forEach(component => { %>
                    <option value="">--------</option>
                    <option value="<%= component._id %>"><%= component.componnentname %></option>
                <% }) %>
            </select>
        </div>

        <div class="pc-builds">
            <label for="components">Storage:</label>
            <select required name="components" id="storage" required>
                <% storageComponents.forEach(component => { %>
                    <option value="">--------</option>
                    <option value="<%= component._id %>"><%= component.componnentname %></option>
                <% }) %>
            </select>
        </div>

        <div class="pc-builds">
            <label for="components">POWER SUPPLY:</label>
            <select required name="components" id="power supply" required>
                <% powerSupplyComponents.forEach(component => { %>
                    <option value="">--------</option>
                    <option value="<%= component._id %>"><%= component.componnentname %></option>
                <% }) %>
            </select>
        </div>
        

        <br>
        <button type="submit">Save Build</button>
    </form>

</body>
</html>