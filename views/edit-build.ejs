<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>edit page</title>
</head>

<body>
      <link rel="stylesheet" href="/css/style.css">
    <%- include('./partials/navbar') %>
        <h1>edit your pc</h1>
        <form action="/pc-builds/<%=build.id%>?_method=PUT" method="POST" class="build-form">

        <div class="parts">
            <label for="name">PC BUILD NAME:</label><br>
            <input type="text" id="name" name="name" value="<%=build.name%>"  required><br><br>
        
        <div class="pc-builds">
            <label for="components">Processor (CPU):</label>
            <select name="components" id="cpu" required>
                <% cpuComponents.forEach(component => { %>
                    <option <% if(componentNames.includes(component.componnentname)){ %>selected <% } %> value="<%= component._id %>" data-price="<%= component.price %>"><%= component.componnentname %>- <%= component.price %> BHD  <img src="<%=component.image%>" alt="image"></option>
                <% }) %>
            </select>
        </div>

        <div class="pc-builds">
            <label for="components">Graphics Processing Unit (GPU):</label>
            <select name="components" id="gpu" required>
                <% gpuComponents.forEach(component => { %>
                    <option <% if(componentNames.includes(component.componnentname)){ %>selected <% } %>  value="<%= component._id %>" data-price="<%= component.price %>"><%= component.componnentname %> - <%= component.price %> BHD  <img src="<%=component.image%>" alt="image"></option>
                <% }) %>
            </select>
        </div>

        <div class="pc-builds">
            <label for="components">Random Access Memory (RAM):</label>
            <select name="components" id="ram" required>
                <% ramComponents.forEach(component => { %>
                    <option <% if(componentNames.includes(component.componnentname)){ %>selected <% } %>  value="<%= component._id %>" data-price="<%= component.price %>"><%= component.componnentname %> - <%= component.price %> BHD  <img src="<%=component.image%>" alt="image"></option>
                <% }) %>
            </select>
        </div>

        <div class="pc-builds">
            <label for="components">MOTHERBOARD:</label>
            <select name="components" id="motherboard" required>
                <% motherboardComponents.forEach(component => { %>
                    <option <% if(componentNames.includes(component.componnentname)){ %>selected <% } %>  value="<%= component._id %>" data-price="<%= component.price %>"><%= component.componnentname %> - <%= component.price %> BHD  <img src="<%=component.image%>" alt="image"></option>
                <% }) %>
            </select>
        </div>

        <div class="pc-builds">
            <label for="components">CASE:</label>
            <select name="components" id="case" required>
                <% caseComponents.forEach(component => { %>
                    <option <% if(componentNames.includes(component.componnentname)){ %>selected <% } %>  value="<%= component._id %>" data-price="<%= component.price %>"><%= component.componnentname %> - <%= component.price %> BHD  <img src="<%=component.image%>" alt="image"></option>
                <% }) %>
            </select>
        </div>

        <div class="pc-builds">
            <label for="components">Storage:</label>
            <select name="components" id="Storage" required>
                <% storageComponents.forEach(component => { %>
                    <option <% if(componentNames.includes(component.componnentname)){ %>selected <% } %>  value="<%= component._id %>" data-price="<%= component.price %>"><%= component.componnentname %> - <%= component.price %> BHD  <img src="<%=component.image%>" alt="image"></option>
                <% }) %>
            </select>
        </div>

        <div class="pc-builds">
            <label for="components">POWER SUPPLY:</label>
            <select name="components" id="power supply" required>
                <% powerSupplyComponents.forEach(component => { %>
                    <option <% if(componentNames.includes(component.componnentname)){ %>selected <% } %>  value="<%= component._id %>" data-price="<%= component.price %>"><%= component.componnentname %> - <%= component.price %> BHD  <img src="<%=component.image%>" alt="image"></option>
                <% }) %>
            </select>
        </div>
        
        </div>
      <div class="summery">
        <h2>Build Summary</h2>
        <p>Edit your selected PC components.</p>

        <div id="selectedParts"></div>

        <h3>
            Total Price: <span id="total">0.00</span> BHD
        </h3>

        <button type="submit">Update Build</button>
    </div>

</form>

<script src="/css/js/summary.js"></script>

</body>

</html>