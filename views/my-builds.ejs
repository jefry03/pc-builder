 <link rel="stylesheet" href="/css/style.css">
<h1>My PC Builds</h1>

<a href="/components" class="creat-btn">Create New Build</a>

<% builds.forEach((build) => { %>
  <div class="build-card">
    <h2><%= build.name %></h2>

    <h3>Components:</h3>
    <% let totalPrice = 0 %>

    <% build.components.forEach((component) => { %>
      <% if (component) { %>
      <% totalPrice += component.price %>
        <p>
          Component name: <%= component.componnentname %>
          - <%= component.price %> BHD
        </p>
      <% } %>
    <% }) %>


    <a href="/pc-builds/<%= build._id %>/edit" class="edit-btn">Edit</a>

    <h3>
      Total Price: <%= totalPrice ?? 0 %> BHD
    </h3>

    <hr>
  </div>

  <form action="/pc-builds/<%= build._id %>?_method=DELETE"
        method="POST">
    <button type="submit" class="delete-btn">Delete</button>
  </form>

<% }) %>

