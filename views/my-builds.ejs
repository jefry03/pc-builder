<h1>My PC Builds</h1>

<a href="/components">Create New Build</a>

<% builds.forEach((build) => { %>
  <div>
    <h2><%= build.name %></h2>

    <h3>Components:</h3>

    <% build.components.forEach((component) => { %>
      <% if (component) { %>
        <p>
          Component name: <%= component.componnentname %>
          - <%= component.price %> BHD
        </p>
      <% } %>
    <% }) %>


    <h3>Total Price: <%= build.totalPrice ?? 0 %> BHD</h3>
      
    <hr>
  </div>

  <form action="/pc-builds/<%= build._id %>?_method=DELETE"
        method="POST">
    <button type="submit">Delete</button>
  </form>

<% }) %>

