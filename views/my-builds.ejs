
<link rel="stylesheet" href="/css/style.css">

<div class="my-builds">

  <h1>My PC Builds</h1>

  <a href="/components" class="create-btn">Create New Build</a>

  <% builds.forEach((build) => { %>

    <div class="build-card">

      <h2><%= build.name %></h2>

      <h3>Components:</h3>

      <% let totalPrice = 0 %>

      <% build.components.forEach((component) => { %>
        <% if (component) { %>
          <% totalPrice += component.price %>

          <div class="component-item">
            <span><%= component.componnentname %></span>
            <span><%= component.price %> BHD</span>
          </div>

        <% } %>
      <% }) %>

      <h3 class="build-total">
        Total Price: <%= totalPrice.toFixed(2) %> BHD
      </h3>

      <div class="build-buttons">

        <a href="/pc-builds/<%= build._id %>/edit" class="edit-btn">
          Edit Build
        </a>

        <form action="/pc-builds/<%= build._id %>?_method=DELETE" method="POST">
          <button type="submit" class="delete-btn">Delete</button>
        </form>

      </div>

    </div>

  <% }) %>

</div>
