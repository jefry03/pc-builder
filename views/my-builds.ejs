<link rel="stylesheet" href="/css/style.css">
<link rel="stylesheet" href="/css/my-builds.css">
<h1>My PC Builds</h1>

<a href="/components" class="creat-btn">Create New Build</a>

<% builds.forEach((build)=> { %>
  <div class="build-card">
    <% let totalPrice=0 %>
      <% build.components.forEach((component)=> { %>
        <% if (component) { %>
          <% totalPrice +=component.price %>
            <% } %>
              <% }) %>
                <div class="build-header">
                  <h2>
                    <%= build.name %>
                  </h2>
                  <h3> Total Price: <%= totalPrice.toFixed(2) %> BHD </h3>

                </div>
                <h3>Components:</h3>
                <div class="components-grid">
                <% build.components.forEach((component)=> { %>
                  <% if (component) { %>
                    <div class="component-card">
                      <h4><%= component.category%></h4>
                     <p> <%= component.componnentname %></p>
                      <img class="component-image" src="<%=component.image%>" alt="image">
                      <span><%= component.price %> BHD</span>
                    </div>
                    <% } %>
                      <% }) %>
                  </div>
                         <div class="build-actions">
                        <a href="/pc-builds/<%= build._id %>/edit" class="edit-btn">Edit</a>


                        <form action="/pc-builds/<%= build._id %>?_method=DELETE" method="POST">
                          <button type="submit" class="delete-btn">Delete</button>
                       </form>
  </div>
   </div>

  <% }) %>